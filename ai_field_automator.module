/**
 * Implements hook_permission().
 */
function ai_field_automator_permission() {
  return [
    'administer ai field automator' => [
      'title'       => t('Administer AI Field Automator'),
      'description' => t('Manage per-field AI automator settings.'),
    ],
  ];
}

// ---------------------------------------------------------------------------
// Menu (overview only)
// ---------------------------------------------------------------------------

/**
 * Implements hook_menu().
 */
function ai_field_automator_menu() {
  $items = [];

  $items['admin/config/ai/ai-field-automator'] = [
    'title'            => 'AI Field Automator',
    'description'      => 'Overview of all fields with AI Automator enabled.',
    'page callback'    => 'ai_field_automator_overview_page',
    'access arguments' => ['administer ai field automator'],
    'parent'           => 'admin/config/ai',
  ];

  $items['admin/config/ai/field-automator/overview'] = [
    'title'  => 'Overview',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  ];

  // Standalone chain route (for direct links from the overview page).
  $items['admin/config/ai/field-automator/chain/%/%'] = [
    'title'            => 'Automator Chain',
    'description'      => 'Reorder automators for a content type.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['ai_field_automator_chain_form', 5, 6],
    'access arguments' => ['administer ai field automator'],
    'file'             => 'includes/AIFieldAutomatorChainForm.inc',
  ];

  // Add "AI Automator Run Order" local task tab on each entity bundle's
  // admin page (alongside "Manage fields" and "Manage display").
  foreach (entity_get_info() as $entity_type => $entity_info) {
    if (empty($entity_info['fieldable'])) {
      continue;
    }
    foreach ($entity_info['bundles'] as $bundle_name => $bundle_info) {
      if (!isset($bundle_info['admin']['path'])) {
        continue;
      }
      $path = $bundle_info['admin']['path'];

      // Determine the bundle argument position (same logic as field_ui).
      if (isset($bundle_info['admin']['bundle argument'])) {
        $bundle_arg = $bundle_info['admin']['bundle argument'];
      }
      else {
        $bundle_arg = $bundle_name;
      }

      $items["$path/automator-chain"] = [
        'title'            => 'AI Automator Run Order',
        'page callback'    => 'backdrop_get_form',
        'page arguments'   => ['ai_field_automator_chain_form', $entity_type, $bundle_arg],
        'access arguments' => ['administer ai field automator'],
        'type'             => MENU_LOCAL_TASK,
        'weight'           => 100,
        'file'             => 'includes/AIFieldAutomatorChainForm.inc',
      ];
    }
  }

  return $items;
}

/**
 * Implements hook_theme().
 */
function ai_field_automator_theme() {
  return [
    'ai_field_automator_chain_table' => [
      'render element' => 'element',
      'file' => 'includes/AIFieldAutomatorChainForm.inc',
    ],
  ];
}

/**
 * Preprocesses the chain form to use the custom table theme for the items.
 */
function ai_field_automator_form_ai_field_automator_chain_form_alter(&$form, &$form_state) {
  if (isset($form['items'])) {
    $form['items']['#theme'] = 'ai_field_automator_chain_table';
  }
}

/**
 * Page callback: overview of all active automator configs.
 */
function ai_field_automator_overview_page() {
  $configs = config_get_names_with_prefix('ai_field_automator.');
  $rows = [];
  $bundles_seen = [];

  foreach ($configs as $config_name) {
    $c = config_get($config_name);
    if (empty($c) || empty($c['enabled'])) {
      continue;
    }
    $entity_type = $c['entity_type'];
    $bundle      = $c['bundle'];
    $field_name  = $c['field_name'];

    $bundles_seen["{$entity_type}/{$bundle}"] = [
      'entity_type' => $entity_type,
      'bundle' => $bundle,
    ];

    // Link directly to field edit for node bundles.
    $field_cell = check_plain($field_name);
    if ($entity_type === 'node') {
      $edit_path = "admin/structure/types/manage/{$bundle}/fields/{$field_name}";
      $field_cell = l($field_name, $edit_path);
    }

    // Chain link for the bundle.
    $chain_link = '';
    if ($entity_type === 'node') {
      $chain_link = l(t('Run order'), "admin/structure/types/manage/{$bundle}/automator-chain");
    }
    else {
      $chain_link = l(t('Run order'), "admin/config/ai/field-automator/chain/{$entity_type}/{$bundle}");
    }

    $label = !empty($c['label']) ? $c['label'] : '';

    $rows[] = [
      check_plain($label),
      check_plain($entity_type),
      check_plain($bundle),
      $field_cell,
      check_plain($c['automator_type']),
      check_plain($c['worker_type'] ?? 'direct'),
      check_plain($c['weight'] ?? 0),
      check_plain($c['model'] ?? ''),
      $chain_link,
    ];
  }

  if (empty($rows)) {
    return '<p>' . t('No AI Automators configured yet. Edit any field on a content type to enable one.') . '</p>';
  }

  // Sort by entity_type, bundle, weight.
  usort($rows, function ($a, $b) {
    if ($a[1] !== $b[1]) return strcmp($a[1], $b[1]);
    if ($a[2] !== $b[2]) return strcmp($a[2], $b[2]);
    return (int) strip_tags($a[6]) - (int) strip_tags($b[6]);
  });

  return theme('table', [
    'header' => [t('Label'), t('Entity type'), t('Bundle'), t('Field'), t('Automator type'), t('Worker'), t('Weight'), t('Model'), t('Run order')],
    'rows'   => $rows,
  ]);
}

// ---------------------------------------------------------------------------
// Field instance edit form integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function ai_field_automator_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  if (!empty($form['#field']['field_name']) && $form['#field']['field_name'] === AIFieldAutomatorStatusField::FIELD_NAME) {
    // Avoid list.module default-value widget assumptions for this locked
    // internal field.
    $form['#instance']['default_value_function'] = 'ai_field_automator_status_default_value';
  }

  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorFieldForm');
  _ai_field_automator_field_edit_form_alter($form, $form_state);
}

/**
 * Default value callback for the internal status field.
 */
function ai_field_automator_status_default_value($entity_type, $entity, $field, $instance, $langcode) {
  return [
    ['value' => AIFieldAutomatorStatusField::STATUS_PENDING],
  ];
}

/**
 * Implements hook_field_widget_form_alter().
 *
 * Adds an on-demand "Generate with AI" button to supported widgets when the
 * destination field has an enabled automator configuration.
 */
function ai_field_automator_field_widget_form_alter(&$element, &$form_state, $context) {
  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorWidgetActions');
  _ai_field_automator_field_widget_form_alter($element, $form_state, $context);
}

/**
 * Submit callback wrapper for widget action button.
 */
function ai_field_automator_widget_action_submit($form, &$form_state) {
  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorWidgetActions');
  _ai_field_automator_widget_action_submit($form, $form_state);
}

/**
 * AJAX callback wrapper for widget action button.
 */
function ai_field_automator_widget_action_ajax($form, &$form_state) {
  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorWidgetActions');
  return _ai_field_automator_widget_action_ajax($form, $form_state);
}

/**
 * Validate callback proxy for field_ui_field_edit_form.
 */
function ai_field_automator_field_edit_form_validate($form, &$form_state) {
  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorFieldForm');
  _ai_field_automator_field_edit_form_validate($form, $form_state);
}

/**
 * Submit callback proxy for field_ui_field_edit_form.
 */
function ai_field_automator_field_edit_form_submit($form, &$form_state) {
  module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorFieldForm');
  _ai_field_automator_field_edit_form_submit($form, $form_state);

  // Auto-create or remove the status field based on whether any automators
  // are now configured on this bundle.
  $instance = $form['#instance'];
  if (!empty($instance['entity_type']) && !empty($instance['bundle'])) {
    AIFieldAutomatorStatusField::modifyStatusField($instance['entity_type'], $instance['bundle']);
  }
}

// ---------------------------------------------------------------------------
// Cleanup when a field instance is deleted
// ---------------------------------------------------------------------------

/**
 * Implements hook_field_delete_instance().
 */
function ai_field_automator_field_delete_instance($instance) {
  // Don't process deletion of the status field itself.
  if ($instance['field_name'] === AIFieldAutomatorStatusField::FIELD_NAME) {
    return;
  }

  $key = 'ai_field_automator.'
    . $instance['entity_type'] . '.'
    . $instance['bundle'] . '.'
    . $instance['field_name'];
  $c = config($key);
  if (!$c->isNew()) {
    $c->delete();
  }

  // Check if the status field should be removed now.
  AIFieldAutomatorStatusField::modifyStatusField($instance['entity_type'], $instance['bundle']);
}

// ---------------------------------------------------------------------------
// Entity save hooks
// ---------------------------------------------------------------------------

/**
 * Implements hook_node_presave().
 */
function ai_field_automator_node_presave($node) {
  if (!ai_field_automator_entity_can_save_toggle()) {
    return;
  }
  if (ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->processEntity('node', $node, ['workers' => ['direct', 'batch']]);
}

/**
 * Implements hook_taxonomy_term_presave().
 */
function ai_field_automator_taxonomy_term_presave($term) {
  if (!ai_field_automator_entity_can_save_toggle()) {
    return;
  }
  if (ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->processEntity('taxonomy_term', $term, ['workers' => ['direct', 'batch']]);
}

/**
 * Implements hook_node_insert().
 */
function ai_field_automator_node_insert($node) {
  if (!ai_field_automator_entity_can_save_toggle() || ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->enqueueEntity('node', $node);
}

/**
 * Implements hook_node_update().
 *
 * Skipped during internal saves (queue worker, batch) — otherwise the queue
 * worker's node_save() would re-enqueue the same node and every cron run
 * would re-process it forever.
 */
function ai_field_automator_node_update($node) {
  if (!ai_field_automator_entity_can_save_toggle() || ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->enqueueEntity('node', $node);
}

/**
 * Implements hook_form_alter().
 *
 * Adds post-save batch handling for worker_type=batch on node edit forms.
 */
function ai_field_automator_form_alter(&$form, &$form_state, $form_id) {
  if (!empty($form['#node']) && is_object($form['#node'])) {
    if (!in_array('ai_field_automator_node_form_capture_preview_submit', $form['#submit'], TRUE)) {
      array_unshift($form['#submit'], 'ai_field_automator_node_form_capture_preview_submit');
    }
    if (!in_array('ai_field_automator_node_form_submit', $form['#submit'], TRUE)) {
      $form['#submit'][] = 'ai_field_automator_node_form_submit';
    }
    module_load_include('inc', 'ai_field_automator', 'includes/AIFieldAutomatorWidgetActions');
    _ai_field_automator_node_form_add_taxonomy_widget_action_buttons($form, $form_state);
  }
}

/**
 * Node form pre-submit handler to capture unsaved rendered text context.
 */
function ai_field_automator_node_form_capture_preview_submit($form, &$form_state) {
  $node = !empty($form_state['node']) && is_object($form_state['node']) ? $form_state['node'] : ($form['#node'] ?? NULL);
  if (!$node || empty($node->type) || empty($form_state['values']) || !is_array($form_state['values'])) {
    return;
  }

  $preview_text = ai_field_automator_extract_node_preview_text_from_form_state($form_state['values'], $node->type);
  if ($preview_text !== '') {
    $node->ai_field_automator_preview_text = $preview_text;
    if (!empty($form_state['node']) && is_object($form_state['node'])) {
      $form_state['node']->ai_field_automator_preview_text = $preview_text;
    }
  }
}

/**
 * Node form submit handler for batch worker mode.
 */
function ai_field_automator_node_form_submit($form, &$form_state) {
  if (empty($form_state['node']) || empty($form_state['node']->nid)) {
    return;
  }
  $node = $form_state['node'];
  $bundle = $node->type;

  $instances = field_info_instances('node', $bundle);
  if (empty($instances)) {
    return;
  }

  $operations = [];
  foreach (array_keys($instances) as $field_name) {
    $config = ai_field_automator_load_field_config('node', $bundle, $field_name);
    if (!empty($config['enabled']) && (($config['worker_type'] ?? 'direct') === 'batch')) {
      $operations[] = ['ai_field_automator_batch_process_field', ['node', (int) $node->nid, $field_name]];
    }
  }

  if (empty($operations)) {
    return;
  }

  $batch = [
    'title' => t('Running AI Automators'),
    'operations' => $operations,
    'finished' => 'ai_field_automator_batch_finished',
    'progress_message' => t('Processed @current of @total fields...'),
    'error_message' => t('AI Automator batch processing encountered an error.'),
  ];
  batch_set($batch);
}

/**
 * Implements hook_taxonomy_term_insert().
 */
function ai_field_automator_taxonomy_term_insert($term) {
  if (!ai_field_automator_entity_can_save_toggle() || ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->enqueueEntity('taxonomy_term', $term);
}

/**
 * Implements hook_taxonomy_term_update().
 *
 * Same internal-save guard as ai_field_automator_node_update().
 */
function ai_field_automator_taxonomy_term_update($term) {
  if (!ai_field_automator_entity_can_save_toggle() || ai_field_automator_is_queue_processing()) {
    return;
  }
  $runner = new AIFieldAutomatorRunner();
  $runner->enqueueEntity('taxonomy_term', $term);
}

/**
 * Implements hook_cron_queue_info().
 */
function ai_field_automator_cron_queue_info() {
  return [
    'ai_field_automator_queue' => [
      'worker callback' => 'ai_field_automator_queue_worker',
      'time' => 30,
    ],
  ];
}

/**
 * Queue worker callback for queue/cron automator tasks.
 */
function ai_field_automator_queue_worker($data) {
  $entity_type = $data['entity_type'] ?? '';
  $entity_id = $data['entity_id'] ?? 0;
  if (empty($entity_type) || empty($entity_id)) {
    return;
  }

  $loaded = entity_load($entity_type, [$entity_id]);
  $entity = $loaded ? reset($loaded) : NULL;
  if (!$entity) {
    return;
  }

  [, , $bundle] = entity_extract_ids($entity_type, $entity);
  if (empty($bundle)) {
    return;
  }

  $runner = new AIFieldAutomatorRunner();
  $runner->processEntity($entity_type, $entity, [
    'workers' => ['queue_cron'],
  ]);

  // Avoid recursive queueing/presave loops when saving from queue worker.
  ai_field_automator_entity_can_save_toggle(FALSE);
  ai_field_automator_set_queue_processing(TRUE);
  try {
    if ($entity_type === 'node') {
      node_save($entity);
    }
    elseif ($entity_type === 'taxonomy_term') {
      taxonomy_term_save($entity);
    }
    elseif (method_exists($entity, 'save')) {
      $entity->save();
    }
    else {
      entity_get_controller($entity_type)->save($entity);
    }
  }
  finally {
    ai_field_automator_set_queue_processing(FALSE);
    ai_field_automator_entity_can_save_toggle(TRUE);
  }
}

/**
 * Batch operation callback for one field.
 */
function ai_field_automator_batch_process_field($entity_type, $entity_id, $field_name, &$context) {
  if ($entity_type !== 'node') {
    return;
  }
  $node = node_load($entity_id);
  if (!$node) {
    return;
  }

  $runner = new AIFieldAutomatorRunner();
  $runner->processEntity('node', $node, [
    'workers' => ['batch'],
    'specific_field' => $field_name,
  ]);

  // Save without triggering automator presave recursion.
  ai_field_automator_entity_can_save_toggle(FALSE);
  try {
    node_save($node);
  }
  finally {
    ai_field_automator_entity_can_save_toggle(TRUE);
  }

  $context['message'] = t('Processed field @field', ['@field' => $field_name]);
}

/**
 * Batch finished callback.
 */
function ai_field_automator_batch_finished($success, $results, $operations) {
  if ($success) {
    backdrop_set_message(t('AI Automator batch processing completed.'));
  }
  else {
    backdrop_set_message(t('AI Automator batch processing failed.'), 'error');
  }
}

/**
 * Extracts aggregate unsaved text from node form values, including paragraphs.
 */
function ai_field_automator_extract_node_preview_text_from_form_state(array $values, $bundle, array $options = []) {
  return AIContentExtractor::extractNodeFormValuesText($values, $bundle, $options);
}

/**
 * Recursively collects text fragments from nested form value arrays.
 */
function ai_field_automator_collect_text_recursive($value, array &$out) {
  AIContentExtractor::collectTextRecursive($value, $out);
}

/**
 * Sets queue-processing guard flag for this request.
 */
function ai_field_automator_set_queue_processing($processing) {
  $flag = &backdrop_static(__FUNCTION__, FALSE);
  $flag = (bool) $processing;
}

/**
 * Returns TRUE while queue worker is internally saving entities.
 */
function ai_field_automator_is_queue_processing() {
  $flag = &backdrop_static('ai_field_automator_set_queue_processing', FALSE);
  return (bool) $flag;
}

/**
 * Global toggle for save-time automator processing.
 *
 * Similar to Drupal ai_automators save toggle behavior.
 */
function ai_field_automator_entity_can_save_toggle($new_toggle = NULL) {
  $toggle = &backdrop_static(__FUNCTION__, TRUE);
  if ($new_toggle !== NULL) {
    $toggle = (bool) $new_toggle;
  }
  return (bool) $toggle;
}

// ---------------------------------------------------------------------------
// Plugin registry
// ---------------------------------------------------------------------------

/**
 * Returns all registered automator type definitions, cached for the request.
 *
 * Each definition array has keys:
 *   - label       (string)  Human-readable name.
 *   - description (string)  Optional.
 *   - field_types (array)   Backdrop field type machine names this handles.
 *   - class       (string)  PHP class name implementing AIFieldAutomatorInterface.
 *   - file        (string)  Absolute path to the file defining the class.
 *
 * Any module can add types via hook_ai_field_automator_type_info().
 *
 * @return array Keyed by plugin id.
 */
function ai_field_automator_get_types() {
  $types = &backdrop_static(__FUNCTION__);
  if (isset($types)) {
    return $types;
  }
  $types = module_invoke_all('ai_field_automator_type_info');
  backdrop_alter('ai_field_automator_type_info', $types);
  return $types;
}

/**
 * Instantiates an automator plugin by type id.
 *
 * @param string $type_id
 * @param array $definition
 *
 * @return AIFieldAutomatorInterface|null
 */
function ai_field_automator_load_plugin($type_id, array $definition) {
  if (!empty($definition['file']) && file_exists($definition['file'])) {
    require_once $definition['file'];
  }
  $class = $definition['class'];
  if (!class_exists($class)) {
    watchdog('ai_field_automator', 'Plugin class %class not found for type %id.', [
      '%class' => $class,
      '%id'    => $type_id,
    ], WATCHDOG_ERROR);
    return NULL;
  }
  return new $class();
}

