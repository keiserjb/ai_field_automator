// ---------------------------------------------------------------------------
// Config helpers
// ---------------------------------------------------------------------------

/**
 * Loads the automator config for a specific field instance.
 * Result is statically cached; reset with backdrop_static_reset().
 *
 * @param string $entity_type
 * @param string $bundle
 * @param string $field_name
 *
 * @return array|null  Config data array, or NULL if not configured.
 */
function ai_field_automator_load_field_config($entity_type, $bundle, $field_name) {
  $cache = &backdrop_static(__FUNCTION__, []);
  $key   = $entity_type . '.' . $bundle . '.' . $field_name;
  if (!array_key_exists($key, $cache)) {
    $cache[$key] = config_get('ai_field_automator.' . $key) ?: NULL;
  }
  return $cache[$key];
}

/**
 * Returns provider-grouped model options for a select element.
 *
 * Returns a nested array [Provider Label => [provider/model_id => label]]
 * which Backdrop renders as <optgroup> elements in the select widget.
 * The stored value is the fully-qualified "provider/model_id" string that
 * ai_chat() and ai_get_api_for_model() already understand.
 */
function ai_field_automator_model_options($automator_type = '') {
  $callback = 'ai_get_all_chat_models';
  if (in_array($automator_type, ['text_to_image', 'media_image_generation', 'video_to_image'], TRUE)) {
    $callback = 'ai_get_all_image_models';
  }
  elseif (in_array($automator_type, ['text_to_speech', 'media_audio_generation'], TRUE)) {
    $callback = 'ai_get_all_tts_models';
  }
  elseif ($automator_type === 'image_to_text') {
    $callback = 'ai_get_all_vision_models';
  }
  elseif (in_array($automator_type, ['audio_to_text', 'video_to_text'], TRUE)) {
    $callback = function_exists('ai_get_all_stt_models') ? 'ai_get_all_stt_models' : 'ai_get_all_models';
  }
  elseif ($automator_type === 'agent_field' && function_exists('ai_get_all_tool_calling_models')) {
    $callback = 'ai_get_all_tool_calling_models';
  }
  elseif (strpos($automator_type, 'vector_search') !== FALSE && function_exists('ai_get_all_models_for_method')) {
    $callback = function() {
      return ai_get_all_models_for_method('getEmbeddingModels');
    };
  }

  if (is_callable($callback)) {
    try {
      $models = call_user_func($callback);
      if (empty($models) && $callback !== 'ai_get_all_chat_models' && function_exists('ai_get_all_chat_models')) {
        $models = ai_get_all_chat_models();
      }
      if (is_array($models)) {
        ksort($models);
        foreach ($models as $provider => &$pmodels) {
          if (is_array($pmodels)) {
            natcasesort($pmodels);
          }
        }
        unset($pmodels);
      }
      return $models ?: [];
    }
    catch (\Exception $e) {
      watchdog('ai_field_automator', 'Could not load model list: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
      return [];
    }
  }

  return [];
}

/**
 * Ensures Backdrop core token functions are available.
 *
 * @return bool
 *   TRUE if token replacement support is available.
 */
function ai_field_automator_tokens_available() {
  if (!function_exists('token_replace')) {
    require_once BACKDROP_ROOT . '/core/includes/token.inc';
  }
  return function_exists('token_replace');
}

/**
 * Renders a token-based prompt for an entity, if token support is available.
 *
 * @param string $template
 *   Token template.
 * @param object $entity
 *   Entity object.
 * @param string $entity_type
 *   Entity type machine name.
 *
 * @return string
 *   Rendered prompt string (or original template if Token is unavailable).
 */
function ai_field_automator_render_token_prompt($template, $entity, $entity_type) {
  if (!ai_field_automator_tokens_available()) {
    return $template;
  }

  $token_type = ($entity_type === 'taxonomy_term') ? 'term' : $entity_type;
  $data = [$token_type => $entity];
  return token_replace($template, $data, ['clear' => TRUE]);
}

/**
 * Removes generated values rejected by a plugin verifier.
 *
 * @param AIFieldAutomatorInterface $plugin
 *   Plugin instance.
 * @param object $entity
 *   Entity being processed.
 * @param string $field_name
 *   Destination field name.
 * @param array $config
 *   Automator config.
 * @param array $values
 *   Generated values.
 *
 * @return array
 *   Filtered values array.
 */
function ai_field_automator_filter_generated_values($plugin, $entity, $field_name, array $config, array $values) {
  if (!$plugin || !method_exists($plugin, 'verifyValue')) {
    return $values;
  }

  foreach ($values as $key => $value) {
    if (!$plugin->verifyValue($entity, $value, $field_name, $config)) {
      unset($values[$key]);
    }
  }

  return array_values($values);
}

// ---------------------------------------------------------------------------
// Tool: regenerate_field
// ---------------------------------------------------------------------------

/**
 * Implements hook_ai_tools().
 */
function ai_field_automator_ai_tools() {
  return [
    'regenerate_field' => [
      'definition' => [
        'type'     => 'function',
        'function' => [
          'name'        => 'regenerate_field',
          'description' => 'Re-run the AI field automator for a specific field on a node. Use when you need to refresh AI-generated content after making changes to a node.',
          'parameters'  => [
            'type'       => 'object',
            'properties' => [
              'nid'        => ['type' => 'integer', 'description' => 'Node ID of the node to update.'],
              'field_name' => ['type' => 'string',  'description' => 'Machine name of the field to regenerate.'],
            ],
            'required'   => ['nid', 'field_name'],
          ],
        ],
      ],
      'execute'     => 'ai_field_automator_tool_regenerate_field',
      'operation'   => 'write',
      'destructive' => FALSE,
      // No flat permission key: editing is per-node, enforced via
      // node_access('update') inside the executor.
    ],
  ];
}

/**
 * Executor for the regenerate_field tool.
 */
function ai_field_automator_tool_regenerate_field(array $args) {
  $nid        = (int) ($args['nid'] ?? 0);
  $field_name = (string) ($args['field_name'] ?? '');

  if (!$nid || !$field_name) {
    return json_encode(['error' => 'nid and field_name are required.']);
  }

  $node = node_load($nid);
  if (!$node) {
    return json_encode(['error' => "Node $nid not found."]);
  }
  if (!node_access('update', $node)) {
    return json_encode(['error' => 'You do not have permission to edit this node.']);
  }

  $runner = new ai_field_automator\includes\AIFieldAutomatorRunner();
  $runner->processEntity('node', $node, ['specific_field' => $field_name]);
  node_save($node);

  $lang  = LANGUAGE_NONE;
  $items = $node->{$field_name}[$lang] ?? [];
  $value = '';
  if (!empty($items[0])) {
    $item  = $items[0];
    $value = $item['value'] ?? $item['safe_value'] ?? reset($item) ?? '';
  }

  return json_encode(['nid' => $nid, 'field' => $field_name, 'new_value' => (string) $value]);
}
