// ---------------------------------------------------------------------------
// Async background job support (ai_async integration)
// ---------------------------------------------------------------------------

/**
 * Implements hook_ai_async_callbacks().
 *
 * Registers the field generation callback with ai_async so it can be
 * invoked safely from the background process endpoint.
 */
function ai_field_automator_ai_async_callbacks() {
  return [
    'ai_field_automator_async_generate' => t('Generate an AI field value in the background.'),
  ];
}

/**
 * Async callback: loads a saved entity and runs the field automator.
 *
 * Called by ai_async in a background PHP process. Only runs for saved
 * entities (entity_id is always set in $data).
 *
 * @param array $data
 *   Keys: entity_type, entity_id, bundle, field_name, config, wrapper_id, delta.
 *
 * @return array
 *   Result shape consumed by ai_field_automator_async.js:
 *   - field_name, field_type, wrapper_id, delta, values[].
 *
 * @throws Exception on any failure so ai_async can record the error.
 */
function ai_field_automator_async_generate(array $data) {
  $entity_type = $data['entity_type'];
  $entity_id   = $data['entity_id'];
  $field_name  = $data['field_name'];
  $config      = $data['config'];
  $wrapper_id  = $data['wrapper_id'];
  $delta       = isset($data['delta']) ? (int) $data['delta'] : 0;
  $account_uid = isset($data['account_uid']) ? (int) $data['account_uid'] : 0;

  $entities = entity_load($entity_type, [$entity_id]);
  $entity   = reset($entities);
  if (!$entity) {
    throw new Exception(t('Entity not found: @type/@id.', ['@type' => $entity_type, '@id' => $entity_id]));
  }

  // Respect ai_privacy opt-out settings.
  $bundle = isset($data['bundle']) ? $data['bundle'] : '';
  $account = NULL;
  if ($account_uid > 0) {
    $account = user_load($account_uid);
  }
  if (module_exists('ai_privacy') && !ai_privacy_entity_allowed($entity_type, $bundle, $account)) {
    throw new Exception(t('AI processing is not permitted for @type/@bundle.', ['@type' => $entity_type, '@bundle' => $bundle]));
  }

  $types   = ai_field_automator_get_types();
  $type_id = $config['automator_type'];
  if (empty($types[$type_id])) {
    throw new Exception(t('Unknown automator type: @type.', ['@type' => $type_id]));
  }

  $plugin = ai_field_automator_load_plugin($type_id, $types[$type_id]);
  if (!$plugin) {
    throw new Exception(t('Could not load plugin: @type.', ['@type' => $type_id]));
  }

  $values = $plugin->generate($entity, $field_name, $config);
  $values = ai_field_automator_filter_generated_values($plugin, $entity, $field_name, $config, $values);
  if (empty($values)) {
    throw new Exception(t('No values generated for @field.', ['@field' => $field_name]));
  }

  // Apply joiner if configured.
  $joiner = isset($config['joiner']) ? $config['joiner'] : '';
  if ($joiner !== '' && count($values) > 1) {
    if ($joiner === 'other') {
      $joiner = isset($config['joiner_other']) ? $config['joiner_other'] : '';
    }
    $joiner = str_replace(['\n', '\t'], ["\n", "\t"], $joiner);
    $values = [implode($joiner, $values)];
  }

  $plugin->storeValues($entity, $values, $field_name, $config);
  $items = isset($entity->{$field_name}[LANGUAGE_NONE]) ? $entity->{$field_name}[LANGUAGE_NONE] : [];

  $field_info = field_info_field($field_name);
  $field_type = isset($field_info['type']) ? $field_info['type'] : '';

  if ($field_type === 'taxonomy_term_reference') {
    return [
      'field_name' => $field_name,
      'field_type' => $field_type,
      'wrapper_id' => $wrapper_id,
      'delta'      => $delta,
      'values'     => _ai_field_automator_generated_taxonomy_text($items),
      'generated_items' => $items,
    ];
  }

  return [
    'field_name' => $field_name,
    'field_type' => $field_type,
    'wrapper_id' => $wrapper_id,
    'delta'      => $delta,
    'values'     => $items,
  ];
}

// ---------------------------------------------------------------------------
// Config info
// ---------------------------------------------------------------------------

/**
 * Implements hook_config_info().
 */
function ai_field_automator_config_info() {
  return [
    'ai_field_automator' => [
      'name_key'  => 'field_name',
      'label_key' => 'field_name',
      'group'     => t('AI Field Automator'),
    ],
  ];
}

/**
 * Implements hook_module_implements_alter().
 *
 * Ensure this module's field-ui form alter runs before list.module so we can
 * normalize status-field metadata before list alters the same form.
 */
function ai_field_automator_module_implements_alter(&$implementations, $hook) {
  if ($hook !== 'form_field_ui_field_edit_form_alter') {
    return;
  }
  if (!isset($implementations['ai_field_automator'])) {
    return;
  }
  $group = $implementations['ai_field_automator'];
  unset($implementations['ai_field_automator']);
  $implementations = ['ai_field_automator' => $group] + $implementations;
}

